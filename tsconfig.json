{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native", // Đảm bảo cấu hình jsx chính xác cho React Native
    "baseUrl": ".", // Đảm bảo bạn có thể sử dụng alias import
    "paths": {
      "@/*": ["src/*"] // Điều chỉnh "src/*" cho phù hợp với cấu trúc dự án
    }
  },
  "include": [
    "src", // Thư mục chứa mã nguồn của bạn
    "App.tsx", // Hoặc tên file gốc của ứng dụng
    "index.js" // File entry point gốc của dự án
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
